# The values that make this setup yours.
# Copy this file to dot.conf (ignored by git) and edit it:
#   cp dot.conf.example dot.conf
# config/ refers to them as $name. Format: name=value, no quotes.

hostname=my-mac
git_name=Your Name
git_email=you@example.com
# Title of your SSH key item in 1Password (Personal vault).
ssh_key=GitHub
