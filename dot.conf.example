# The values that make this setup yours.
# Copy this file to dot.conf (ignored by git) and edit it:
#   cp dot.conf.example dot.conf
# config/ refers to them as $name. Format: name=value, no quotes.

hostname=my-mac
git_name=Your Name
git_email=you@example.com
# Title of your SSH key item in 1Password (in your built-in personal vault).
ssh_key=GitHub
# Your GitHub username.
github_user=your-username
# Another name and email for repos under one folder (see `git identity` in
# config/git.conf; delete that line if you don't need it).
site_dir=~/code/you/site
site_git_name=Your Name
site_git_email=you@example.org
# Your editor: zed, code, cursor, nvim, vim or nano.
editor=zed
# Varlock's anonymous usage analytics: enable or disable.
varlock_telemetry=disable
