#!/bin/sh
# dot: the single entry point. Each command is a file in src/commands/:
# dot-<command>, or dot-<group>-<subcommand>. This only finds and runs it.
set -eu

DOT_ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export DOT_ROOT
commands=$DOT_ROOT/src/commands

# Homebrew tools (op, gh, brew) even from a shell opened before Homebrew.
case :$PATH: in *:/opt/homebrew/bin:*) ;; *) [ -d /opt/homebrew/bin ] && PATH=/opt/homebrew/bin:$PATH ;; esac

[ $# -gt 0 ] || exec "$commands/dot-help"
case $1 in
  -h|--help|help) shift; exec "$commands/dot-help" "$@" ;;
  --version) git -C "$DOT_ROOT" log -1 --format='dot %h (%cs)'; exit 0 ;;
  -*) echo "dot: unknown flag '$1'" >&2; echo "Run 'dot --help' for usage." >&2; exit 2 ;;
esac

if [ $# -ge 2 ] && [ -x "$commands/dot-$1-$2" ]; then
  cmd=$1-$2; shift 2
elif [ -x "$commands/dot-$1" ]; then
  cmd=$1; shift
else
  echo "dot: unknown command '$1'" >&2
  # Did you mean…? Commands within two edits of what was typed.
  guess=$(ls "$commands" | sed -n 's/^dot-\([a-z][a-z]*\)$/\1/p' | awk -v w="$1" '
    function dist(a, b,   i, j, la, lb, d, c) {
      la = length(a); lb = length(b)
      for (i = 0; i <= la; i++) d[i, 0] = i
      for (j = 0; j <= lb; j++) d[0, j] = j
      for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
        c = (substr(a, i, 1) != substr(b, j, 1))
        d[i, j] = d[i-1, j] + 1
        if (d[i, j-1] + 1 < d[i, j]) d[i, j] = d[i, j-1] + 1
        if (d[i-1, j-1] + c < d[i, j]) d[i, j] = d[i-1, j-1] + c
      }
      return d[la, lb]
    }
    dist(w, $0) <= 2 { print "    " $0 }')
  [ -z "$guess" ] || printf '\nDid you mean this?\n%s\n' "$guess" >&2
  echo "Run 'dot --help' for usage." >&2
  exit 2
fi

# --help anywhere after the command shows that command's help.
for arg in "$@"; do
  case $arg in -h|--help) exec "$commands/dot-help" $(printf %s "$cmd" | tr - ' ') ;; esac
done
exec "$commands/dot-$cmd" "$@"
