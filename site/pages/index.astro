---
// The landing page. Its sections follow the reader's path through the docs
// (evaluate, adopt, use, extend, agents), and each one ends in a link to the
// docs section that teaches it.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
const install =
  'sh -c "$(curl -fsSL https://raw.githubusercontent.com/rbadillap/dotfiles/main/install.sh)"';
const title = "dot — your Mac, as code";
// Shell braces would read as Astro expressions in the markup, so the code
// sample is a string rendered as text.
const dockFunction = `dock_visibility() {
  case $1 in
    autohide) default com.apple.dock autohide -bool true ;;
    …
  esac
  restart Dock
}`;
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: config.description, route: "/", title }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
>
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
    <h1 class="max-w-3xl text-balance font-medium text-4xl sm:text-5xl lg:text-6xl">
      <span class="block">Your Mac,</span>
      <span class="block text-muted-foreground">as code</span>
    </h1>
    <p class="mt-8 max-w-xl text-pretty text-lg text-muted-foreground">
      Set it up from plain text, keep it that way, and work on your projects.
      One command on a clean Mac; one line per setting after that.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <button
        class="group flex max-w-full items-center gap-3 rounded-lg border px-4 py-2.5 text-left font-mono text-sm hover:bg-muted"
        data-copy={install}
        type="button"
      >
        <span class="text-muted-foreground">$</span>
        <span class="truncate">sh -c "$(curl -fsSL …/install.sh)"</span>
        <span class="text-muted-foreground text-xs group-hover:text-foreground" data-copy-label>Copy</span>
      </button>
      <a class="font-medium text-sm hover:underline" href="/docs/get-started/install">Get started →</a>
      <a class="text-muted-foreground text-sm hover:text-foreground" href="/docs">Read the docs</a>
    </div>
  </section>

  <div class="mx-auto grid max-w-5xl gap-24 px-6 pb-24">
    <section>
      <h2 class="font-medium text-2xl sm:text-3xl">Fork it. It's yours.</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        The engine is shared; the choices are yours. Everything personal lives in
        one file that git ignores.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border p-5">
          <p class="font-mono text-sm">1 · fork</p>
          <p class="mt-2 text-muted-foreground text-sm">Your apps, preferences and tools live in <code>config/</code>.</p>
        </div>
        <div class="rounded-xl border p-5">
          <p class="font-mono text-sm">2 · dot.toml</p>
          <p class="mt-2 text-muted-foreground text-sm">Your name, identities and organizations, backed up to 1Password.</p>
        </div>
        <div class="rounded-xl border p-5">
          <p class="font-mono text-sm">3 · dot apply</p>
          <p class="mt-2 text-muted-foreground text-sm">Changes only what differs. Running it twice is safe.</p>
        </div>
      </div>
      <a class="mt-6 inline-block text-sm hover:underline" href="/docs/get-started/install">Get started →</a>
    </section>

    <section class="grid items-start gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-medium text-2xl sm:text-3xl">Your Mac, as text</h2>
        <p class="mt-3 text-muted-foreground">
          One line per setting. <code>dot check</code> shows what differs and never
          changes anything; <code>dot explain</code> tells you what any line does.
        </p>
        <a class="mt-6 inline-block text-sm hover:underline" href="/docs/your-mac/apps-and-tools">Your Mac →</a>
      </div>
      <pre class="overflow-x-auto rounded-xl border bg-muted/40 p-5 font-mono text-sm leading-relaxed"><span class="text-muted-foreground"># config/dock.conf</span>
dock visibility hidden
<span class="text-muted-foreground"># config/trackpad.conf</span>
trackpad tap-to-click true

<span class="text-muted-foreground">$ dot check</span>
✓ dock visibility hidden
~ trackpad tap-to-click true</pre>
    </section>

    <section class="grid items-start gap-8 md:grid-cols-2">
      <pre class="order-last overflow-x-auto rounded-xl border bg-muted/40 p-5 font-mono text-sm leading-relaxed md:order-first"><span class="text-muted-foreground">$</span> dot clone vercel/next.js
<span class="text-muted-foreground">~/code/vercel/next.js</span>

<span class="text-muted-foreground">$</span> dot secret attach app-payments PAYMENTS_KEY
<span class="text-muted-foreground">PAYMENTS_KEY=op(op://Dev/app-payments/credential)</span></pre>
      <div>
        <h2 class="font-medium text-2xl sm:text-3xl">Every project, one command away</h2>
        <p class="mt-3 text-muted-foreground">
          Repos land in <code>~/code/owner/repo</code>. Secrets come from 1Password
          when a project runs, never as files on disk.
        </p>
        <a class="mt-6 inline-block text-sm hover:underline" href="/docs/your-projects/clone-and-fork">Your projects →</a>
      </div>
    </section>

    <section class="grid items-start gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-medium text-2xl sm:text-3xl">Make it do more</h2>
        <p class="mt-3 text-muted-foreground">
          A setting is one shell function. <code>dot defaults diff</code> helps you
          find where macOS keeps it, without printing what's private.
        </p>
        <a class="mt-6 inline-block text-sm hover:underline" href="/docs/extend/add-a-setting">Extend dot →</a>
      </div>
      <pre class="overflow-x-auto rounded-xl border bg-muted/40 p-5 font-mono text-sm leading-relaxed"><span class="text-muted-foreground"># src/settings/dock.sh</span>
{dockFunction}</pre>
    </section>

    <section>
      <h2 class="font-medium text-2xl sm:text-3xl">Built for agents too</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border p-5 text-sm">
          <p class="font-medium">Safe to inspect</p>
          <p class="mt-2 text-muted-foreground"><code>dot check</code> never changes anything and never asks for a password.</p>
        </div>
        <div class="rounded-xl border p-5 text-sm">
          <p class="font-medium">Changes wait for you</p>
          <p class="mt-2 text-muted-foreground">Applying, cloning and anything with sudo need your OK.</p>
        </div>
        <div class="rounded-xl border p-5 text-sm">
          <p class="font-medium">Docs for machines</p>
          <p class="mt-2 text-muted-foreground"><code>llms.txt</code> and every page as raw Markdown.</p>
        </div>
      </div>
      <a class="mt-6 inline-block text-sm hover:underline" href="/docs/agents">Agents →</a>
    </section>
  </div>

  <footer class="border-t" slot="footer">
    <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-4 px-6 py-8 text-muted-foreground text-sm">
      <span>MIT · <a class="hover:text-foreground" href="https://github.com/rbadillap/dotfiles">rbadillap/dotfiles</a></span>
      <span class="flex gap-4">
        <a class="hover:text-foreground" href="/docs/reference/commands">Commands</a>
        <a class="hover:text-foreground" href="/docs/reference/settings">Settings</a>
        <a class="hover:text-foreground" href="/docs/reference/dot-toml">dot.toml</a>
      </span>
    </div>
  </footer>
</PageLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      const label = button.querySelector("[data-copy-label]");
      if (label) {
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy"), 1500);
      }
    });
  }
</script>
