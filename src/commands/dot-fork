#!/bin/sh
# Summary: Fork a GitHub repo and clone it with an upstream remote
# Usage: dot fork <repo>
# Group: repos
#
# Forks the repo to your GitHub account, or reuses your fork if you already
# have one (even if GitHub named it differently), clones it with dot clone,
# and adds the original as the "upstream" remote. Forking your own repo just
# clones it. In zsh, dot then takes you to the repo.
#
# Your username comes from github_user in dot.conf, or from gh. Forking goes
# through gh, so it may ask for Touch ID.
#
# ARGUMENTS
#   <repo> accepts the same forms as dot clone.
#
# EXAMPLES
#   $ dot fork vercel/next.js
#
# OUTPUT
#   Messages go to stderr; stdout carries only the repo's path.
#   Exit codes: 0 done, 1 failed, 2 bad usage.
set -eu

clone=$DOT_ROOT/src/commands/dot-clone

die() { echo "dot fork: $*" >&2; exit 1; }
bad() { echo "dot fork: $*" >&2; echo "Run 'dot fork --help' for usage." >&2; exit 2; }
lower() { printf %s "$1" | tr '[:upper:]' '[:lower:]'; }

# gh, through 1Password's shell plugin when that's where its token lives.
ghx() {
  if [ -f "$HOME/.config/op/plugins/gh.json" ]; then op plugin run -- gh "$@"; else gh "$@"; fi
}

# my_login: your GitHub username, from dot.conf or else from gh.
my_login() {
  login=$(sed -n 's/^github_user=//p' "$DOT_ROOT/dot.conf" 2>/dev/null | head -1)
  [ -n "$login" ] || login=$(ghx api user --jq .login 2>/dev/null) || login=
  printf %s "$login"
}

# fork_of <me> <owner/repo>: prints my fork of that repo, if I have one.
fork_of() {
  want=$(lower "$2")
  ghx repo list "$1" --fork --limit 1000 --json nameWithOwner,parent \
    --jq ".[] | select(((.parent.owner.login + \"/\" + .parent.name) | ascii_downcase) == \"$want\") | .nameWithOwner" |
    head -1
}

[ $# -ge 1 ] || bad "missing <repo>"
case $1 in -*) bad "unknown flag '$1'" ;; esac
[ $# -eq 1 ] || bad "expected one repo, got $#"
command -v gh >/dev/null || die "gh isn't installed (config/packages.conf)"

slug=$("$clone" --resolve "$1" 2>/dev/null) ||
  bad "not a GitHub repo: '$1' (see 'dot clone --help' for accepted forms)"
me=$(my_login)
[ -n "$me" ] || die "can't tell your GitHub username: set github_user in dot.conf, or log in to gh"

# The repo as GitHub knows it: right case, renames followed, and it must exist.
info=$(ghx api "repos/$slug" --jq '[.full_name, (.allow_forking | tostring), .owner.login] | join(" ")' 2>/dev/null) ||
  die "can't find $slug on GitHub, or you don't have access"
set -- $info
upstream=$1 allow=$2 owner=$3

if [ "$(lower "$owner")" = "$(lower "$me")" ]; then
  echo "dot fork: $upstream is yours; cloning it instead" >&2
  exec "$clone" "$upstream"
fi

fork=$(fork_of "$me" "$upstream")
if [ -n "$fork" ]; then
  echo "dot fork: you already have a fork: $fork" >&2
else
  [ "$allow" != false ] || die "$upstream doesn't allow forking"
  echo "dot fork: forking $upstream to $me" >&2
  ghx repo fork "$upstream" --clone=false >&2 || die "gh couldn't fork $upstream"
  # Forking is asynchronous, and GitHub renames the fork if the name is taken,
  # so look it up instead of assuming its name.
  for _ in 1 2 3 4 5; do
    fork=$(fork_of "$me" "$upstream")
    [ -n "$fork" ] && break
    sleep 2
  done
  [ -n "$fork" ] || die "forked $upstream, but the fork isn't listed yet; run dot fork again in a moment"
fi

dir=$("$clone" "$fork") || exit 1

have=$(git -C "$dir" remote get-url upstream 2>/dev/null) || have=
if [ -z "$have" ]; then
  git -C "$dir" remote add upstream "git@github.com:$upstream.git"
  echo "dot fork: upstream → $upstream" >&2
else
  have_slug=$("$clone" --resolve "$have" 2>/dev/null) || have_slug=
  [ "$(lower "$have_slug")" = "$(lower "$upstream")" ] ||
    die "upstream in $dir points to $have, not $upstream; fix it by hand"
fi
echo "$dir"
