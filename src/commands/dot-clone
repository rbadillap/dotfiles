#!/bin/sh
# Summary: Clone a GitHub repo into ~/code/<owner>/<repo>
# Usage: dot clone <repo>
# Group: projects
#
# Clones over SSH, with your key from 1Password, into ~/code/<owner>/<repo>
# using GitHub's own spelling of the name. If the repo is already there, it
# only prints the path. It never overwrites a folder that holds something
# else, and a failed clone leaves nothing behind. In zsh, dot then takes you
# to the repo.
#
# ARGUMENTS
#   <repo> is owner/repo, github.com/owner/repo, https://github.com/owner/repo
#   (with .git, /tree/…, ?… or #…), git@github.com:owner/repo or
#   ssh://git@github.com/owner/repo. Only GitHub repos are supported.
#
# FLAGS
#   --resolve   Print owner/repo and exit, without cloning
#
# EXAMPLES
#   $ dot clone vercel/next.js
#   $ dot clone https://github.com/shadcn-ui/ui
#
# OUTPUT
#   Messages go to stderr; stdout carries only the repo's path.
#   Exit codes: 0 cloned or already there, 1 failed, 2 bad usage.
set -eu

CODE_DIR=${CODE_DIR:-$HOME/code}

die() { echo "dot clone: $*" >&2; exit 1; }
bad() { echo "dot clone: $*" >&2; echo "Run 'dot clone --help' for usage." >&2; exit 2; }
tildify() { case $1 in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf %s "$1" ;; esac; }
lower() { printf %s "$1" | tr '[:upper:]' '[:lower:]'; }

# resolve <repo>: prints owner/repo; exits 2 for anything that isn't one.
resolve() {
  s=$1
  case $s in
    https://github.com/*|http://github.com/*|https://www.github.com/*) s=${s#*github.com/} ;;
    github.com/*|www.github.com/*) s=${s#*github.com/} ;;
    git@github.com:*) s=${s#git@github.com:} ;;
    ssh://git@github.com/*) s=${s#ssh://git@github.com/} ;;
    *://*|*@*:*) bad "only GitHub repos are supported, got '$1'" ;;
  esac
  owner=${s%%/*} rest=${s#*/}
  [ "$rest" != "$s" ] || bad "expected owner/repo, got '$1'"
  repo=${rest%%/*}            # drop /tree/main/… and similar
  repo=${repo%%[?#]*}         # drop ?query and #fragment
  repo=${repo%.git}
  case $owner in *.*) bad "only GitHub repos are supported, got '$1'" ;; esac
  case $owner in ''|-*|*[!A-Za-z0-9-]*) bad "invalid GitHub owner '$owner' in '$1'" ;; esac
  case $repo in ''|.|..|*[!A-Za-z0-9._-]*) bad "invalid repo name '$repo' in '$1'" ;; esac
  printf '%s/%s\n' "$owner" "$repo"
}

[ $# -ge 1 ] || bad "missing <repo>"
case $1 in
  --resolve) [ $# -eq 2 ] || bad "--resolve takes one repo"; resolve "$2"; exit 0 ;;
  -*) bad "unknown flag '$1'" ;;
esac
[ $# -eq 1 ] || bad "expected one repo, got $#"

slug=$(resolve "$1") || exit $?
# GitHub's own spelling (case, renames), from its public API; no token needed.
# Private repos aren't visible there, so they keep the spelling given.
canonical=$(curl -fsS "https://api.github.com/repos/$slug" 2>/dev/null | /usr/bin/jq -r '.full_name // empty' 2>/dev/null) || canonical=
[ -z "$canonical" ] || slug=$canonical
dir=$CODE_DIR/$slug

if [ -e "$dir" ]; then
  if [ -d "$dir/.git" ]; then
    origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || origin=
    have=$( (resolve "$origin") 2>/dev/null) || have=
    if [ "$(lower "$have")" = "$(lower "$slug")" ]; then
      echo "dot clone: $slug is already in $(tildify "$dir")" >&2
      echo "$dir"
      exit 0
    fi
    die "$(tildify "$dir") is another repo (origin: ${origin:-none}). Move it aside and retry."
  elif [ ! -d "$dir" ] || [ -n "$(ls -A "$dir")" ]; then
    die "$(tildify "$dir") exists and isn't a git repo. Move it aside and retry."
  fi
fi

mkdir -p "$(dirname "$dir")"
echo "dot clone: git@github.com:$slug.git → $(tildify "$dir")" >&2
git clone "git@github.com:$slug.git" "$dir" >&2 ||
  die "couldn't clone $slug. Does it exist, and can you access it? SSH uses your 1Password key (Touch ID)."
echo "$dir"
