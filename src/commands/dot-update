#!/bin/sh
# Summary: Pull the latest dotfiles, then run check
# Usage: dot update
# Group: additional
#
# Fast-forwards the repo from GitHub (git pull --ff-only), then runs dot check
# to show what the new version would change. It never applies anything: run
# dot apply when you're ready.
set -eu
[ $# -eq 0 ] || { echo "dot update: takes no arguments" >&2; exit 2; }
echo "dot update: pulling $(git -C "$DOT_ROOT" remote get-url origin 2>/dev/null || echo origin)" >&2
git -C "$DOT_ROOT" pull --ff-only >&2 ||
  { echo "dot update: couldn't fast-forward. Commit or stash your changes (git -C $DOT_ROOT status), then retry." >&2; exit 1; }
echo >&2
exec "$DOT_ROOT/dot" check
