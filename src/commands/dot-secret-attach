#!/bin/sh
# Summary: Attach a secret to this project as an environment variable
# Usage: dot secret attach <name> <VARIABLE>
# Group: secret
#
# Adds <VARIABLE> to the .env.schema in the current folder, as a sensitive
# reference to the secret: the value stays in 1Password, and Varlock
# resolves it when the project runs. The schema itself is Varlock's: create
# it with varlock init, and declare its 1Password plugin, before attaching.
# An existing <VARIABLE> is never replaced.
#
# EXAMPLES
#   $ dot secret attach myapp-payments PAYMENTS_KEY
#   $ dot secret attach myapp-github GITHUB_TOKEN
set -eu
. "$DOT_ROOT/src/lib/secret.sh"
[ $# -eq 2 ] || { echo "dot secret attach: expected <name> <VARIABLE>. Run 'dot secret attach --help'." >&2; exit 2; }
var=$2
case $var in
  ''|[0-9]*|*[!A-Z0-9_]*) echo "dot secret attach: invalid variable '$var': uppercase letters, digits and '_'" >&2; exit 2 ;;
esac
secret_args attach "$1"
schema=$PWD/.env.schema
if [ ! -f "$schema" ]; then
  echo "dot secret attach: no .env.schema in $PWD. Create it first: varlock init" >&2
  exit 1
fi
if ! grep -q '@plugin(@varlock/1password-plugin' "$schema"; then
  echo "dot secret attach: .env.schema doesn't load Varlock's 1Password plugin. Add to its header, above '# ---':" >&2
  echo "  # @plugin(@varlock/1password-plugin)" >&2
  echo "See https://varlock.dev/plugins/1password/" >&2
  exit 1
fi
if grep -Eq "^[[:space:]]*$var[[:space:]]*=" "$schema"; then
  echo "dot secret attach: $var is already in .env.schema; nothing changed" >&2
  exit 1
fi
if ! op_secret_exists "$vault" "$name"; then
  echo "dot secret attach: no secret $name in $vault. To create it: dot secret add $name" >&2
  exit 1
fi
secret_attach "$schema" "$var" "$(op_secret_ref "$vault" "$name")"
echo "dot secret attach: $var in .env.schema now refers to $name. Check it resolves: varlock explain $var" >&2
