#!/bin/sh
# Summary: Keep project secrets in 1Password
# Usage: dot secret <command>
# Group: additional
#
# Project secrets (API keys, tokens) live in 1Password, in the vault set as
# vault under [secrets] in dot.toml, as API Credential items tagged
# "dotfiles". A project's .env.schema refers to one as
# op://<vault>/<name>/credential, and Varlock resolves it when the project
# runs (docs/secrets/). Name them <project>-<use>. No command ever prints a
# value, and each asks 1Password for Touch ID.
#
# EXAMPLES
#   $ dot secret add myapp-payments
#   $ dot secret list
set -eu
[ $# -eq 0 ] && exec "$DOT_ROOT/src/commands/dot-help" secret
echo "dot secret: unknown command '$1'" >&2
"$DOT_ROOT/src/commands/dot-help" secret >&2
exit 2
