#!/bin/sh
# Summary: Show which logins are done and which are missing
# Usage: dot auth status
# Group: auth
#
# Checks each account this setup uses: the 1Password CLI, GitHub's CLI (gh,
# through 1Password), SSH to GitHub (key from 1Password), Vercel's CLI when
# it's installed (through 1Password), and each AWS organization in dot.toml
# (its SSO session). It asks 1Password for Touch ID, like any command that
# uses those logins.
#
# EXIT CODES
#   0  every login works
#   1  at least one is missing
set -eu
[ $# -eq 0 ] || { echo "dot auth status: takes no arguments" >&2; exit 2; }
. "$DOT_ROOT/src/lib/output.sh"
missing=0
ok()  { printf '  %s✓%s %s\n' "$c_ok" "$c_off" "$1"; }
bad() { printf '  %s!%s %s\n      %s\n' "$c_err" "$c_off" "$1" "$2"; missing=$((missing + 1)); }
ghx() { if [ -f "$HOME/.config/op/plugins/gh.json" ]; then op plugin run -- gh "$@"; else gh "$@"; fi; }

# `op whoami` only knows CLI sessions; with the app integration, `op account get` works.
if who=$(op account get --format json 2>/dev/null | /usr/bin/jq -r '.domain // empty'); [ -n "$who" ]; then
  ok "1Password CLI ($who.1password.com)"
else
  bad "1Password CLI" "open 1Password, sign in, and turn on Settings → Developer → Integrate with 1Password CLI"
fi
if login=$(ghx api user --jq .login 2>/dev/null); [ -n "$login" ]; then
  ok "GitHub CLI ($login)"
else
  bad "GitHub CLI" "see docs/auth/github.md"
fi
if ssh -T -o BatchMode=yes -o ConnectTimeout=10 git@github.com 2>&1 | grep -q 'successfully authenticated'; then
  ok "SSH to GitHub"
else
  bad "SSH to GitHub" "see docs/1password.md: SSH agent, key, and dot apply github"
fi
# Vercel, through 1Password's shell plugin when that's where its token lives.
if command -v vercel >/dev/null; then
  if [ -f "$HOME/.config/op/plugins/vercel.json" ]; then vercelx() { op plugin run -- vercel "$@"; }; else vercelx() { vercel "$@"; }; fi
  if user=$(vercelx whoami 2>/dev/null | tail -1) && [ -n "$user" ]; then
    ok "Vercel CLI ($user)"
  else
    bad "Vercel CLI" "see docs/auth/vercel.md"
  fi
fi
# AWS: one line per [aws.<org>] in dot.toml, tried through its own profile
# (<org>) or else its first one (<org>-<name>).
. "$DOT_ROOT/src/lib/conf.sh"
DOT_CONF=$(conf_parse "$DOT_ROOT/dot.toml" 2>/dev/null) || DOT_CONF=
for org in $(conf_tables aws); do
  if conf_get "aws.$org.role" >/dev/null; then
    profile=$org
  else
    profile=$(conf_tables "aws.$org" | head -1)
    [ -n "$profile" ] || continue
    profile=$org-$profile
  fi
  if ! command -v aws >/dev/null; then
    bad "AWS $org" "dot apply aws"
  elif account=$(aws sts get-caller-identity --profile "$profile" --query Account --output text 2>/dev/null); then
    ok "AWS $org ($profile, $account)"
  else
    bad "AWS $org" "aws sso login --sso-session $org (see docs/auth/aws.md)"
  fi
done

echo
if [ "$missing" -eq 0 ]; then echo "Every login works."; else echo "$missing login(s) missing."; exit 1; fi
