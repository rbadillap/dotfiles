#!/bin/sh
# Summary: Go to the dotfiles repo
# Usage: dot cd
# Group: additional
#
# Prints the repo's path (the working copy, not the live copy). In zsh, dot
# then takes you there.
set -eu
[ $# -eq 0 ] || { echo "dot cd: takes no arguments" >&2; exit 2; }
. "$DOT_ROOT/src/lib/live.sh"
live_repo || echo "$DOT_ROOT"
