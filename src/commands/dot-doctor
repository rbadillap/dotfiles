#!/bin/sh
# Summary: Check that dot's own requirements are in place
# Usage: dot doctor
# Group: additional
#
# Checks what dot itself needs, not your settings (that's dot check): the
# Command Line Tools, Homebrew, 1Password and its CLI, Varlock, dot.toml, and
# the shell setup. Never asks for a password or Touch ID. Each problem comes
# with how to fix it.
#
# EXIT CODES
#   0  everything is in place
#   1  something is missing
set -eu
[ $# -eq 0 ] || { echo "dot doctor: takes no arguments" >&2; exit 2; }
. "$DOT_ROOT/src/lib/output.sh"
problems=0
ok()  { printf '  %s✓%s %s\n' "$c_ok" "$c_off" "$1"; }
bad() { printf '  %s!%s %s\n      %s\n' "$c_err" "$c_off" "$1" "$2"; problems=$((problems + 1)); }
has() { command -v "$1" >/dev/null 2>&1; }

[ "$(uname -m)" = arm64 ] && ok "Apple Silicon Mac" || bad "Apple Silicon Mac" "Homebrew only supports Apple Silicon"
[ -x /Library/Developer/CommandLineTools/usr/bin/git ] && ok "Command Line Tools" ||
  bad "Command Line Tools" "run install.sh, or: xcode-select --install"
[ -x /opt/homebrew/bin/brew ] && ok "Homebrew" || bad "Homebrew" "run install.sh"
[ -d /Applications/1Password.app ] && ok "1Password" || bad "1Password" "dot apply apps"
has op && ok "1Password CLI (op)" || bad "1Password CLI (op)" "dot apply packages"
[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ] && ok "1Password SSH agent" ||
  bad "1Password SSH agent" "1Password → Settings → Developer → Use the SSH agent"
has gh && ok "GitHub CLI (gh)" || bad "GitHub CLI (gh)" "dot apply packages"
has varlock && ok "Varlock" || bad "Varlock" "dot apply packages"

. "$DOT_ROOT/src/lib/conf.sh"
conf=$DOT_ROOT/dot.toml
if [ ! -f "$conf" ]; then
  bad "dot.toml" "dot conf restore, or: cp dot.toml.example dot.toml"
elif ! keys=$(conf_parse "$conf" 2>&1); then
  bad "dot.toml: $(printf '%s\n' "$keys" | tail -1 | sed 's/^dot: //')" "dot conf edit"
else
  keys=$(printf '%s\n' "$keys" | cut -d= -f1)
  missing=$(conf_parse "$DOT_ROOT/dot.toml.example" | cut -d= -f1 | while read -r key; do
    printf '%s\n' "$keys" | grep -qxF "$key" || printf '%s ' "$key"
  done)
  [ -z "$missing" ] && ok "dot.toml" || bad "dot.toml is missing values: $missing" "dot conf edit (see dot.toml.example)"
fi
grep -qF "$DOT_ROOT/bin/dot\" init zsh" "$HOME/.zshrc" 2>/dev/null && ok "Shell setup in ~/.zshrc" ||
  bad "Shell setup in ~/.zshrc" "dot apply shell, then open a new terminal"

echo
if [ "$problems" -eq 0 ]; then echo "Everything dot needs is in place."; else echo "$problems problem(s) found."; exit 1; fi
