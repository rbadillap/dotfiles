#!/bin/sh
# Summary: Open dot.toml in your editor
# Usage: dot conf edit
# Group: conf
#
# Opens dot.toml in $EDITOR (or git's core.editor). If there's no dot.toml
# yet, it starts from dot.toml.example. Afterwards it checks the file is
# valid, and dot conf backup saves the change to 1Password.
set -eu
[ $# -eq 0 ] || { echo "dot conf edit: takes no arguments" >&2; exit 2; }
. "$DOT_ROOT/src/lib/conf.sh"
conf=$DOT_ROOT/dot.toml
[ -f "$conf" ] || cp "$DOT_ROOT/dot.toml.example" "$conf"
editor=${VISUAL:-${EDITOR:-$(git config --global core.editor 2>/dev/null || echo vi)}}
before=$(shasum -a 256 "$conf")
sh -c "$editor \"\$1\"" editor "$conf"
conf_parse "$conf" >/dev/null ||
  { echo "dot conf edit: dot.toml has an error (above). Fix it with: dot conf edit" >&2; exit 1; }
[ "$before" = "$(shasum -a 256 "$conf")" ] ||
  echo "dot conf edit: dot.toml changed. Run 'dot check' to see its effect, and 'dot conf backup' to save it." >&2
