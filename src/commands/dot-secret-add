#!/bin/sh
# Summary: Store a new secret and print its reference
# Usage: dot secret add <name>
# Group: secret
#
# Asks for the value without showing it (or reads it from stdin when piped),
# stores it in the vault set under [secrets] in dot.toml, and prints the
# reference on stdout; dot secret attach then adds it to a project. An existing
# secret is never replaced: that's dot secret update.
#
# ARGUMENTS
#   <name>   lowercase letters, digits, ".", "_" and "-", as <project>-<use>
#
# EXAMPLES
#   $ dot secret add myapp-payments
#   $ pbpaste | dot secret add myapp-payments
set -eu
. "$DOT_ROOT/src/lib/secret.sh"
secret_args add "$@"
if op_secret_exists "$vault" "$name"; then
  echo "dot secret add: $name already exists in $vault. To replace its value: dot secret update $name" >&2
  exit 1
fi
secret_read_value add
printf '%s' "$value" | op_secret_add "$vault" "$name"
ref=$(op_secret_ref "$vault" "$name")
echo "dot secret add: saved $name in $vault. Next, from the project's folder:" >&2
echo "  dot secret attach $name <VARIABLE>" >&2
echo "$ref"
