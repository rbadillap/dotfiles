#!/bin/sh
# Summary: Count the preferences a change in System Settings writes
# Usage: dot defaults diff [--current-host] <domain>...
# Group: defaults
#
# Reads the preference domains you name, asks you to change one setting in
# System Settings, reads them again and reports how many keys were added,
# changed or removed. The report shows no key names or values: preferences
# can hold private information. Afterwards you can reveal one change's key
# name and type, on the terminal only. Changes nothing; needs a terminal,
# no password or Touch ID.
#
# FLAGS
#   --current-host   Read this Mac's preferences (defaults -currentHost)
#                    instead of your user's
#
# ARGUMENTS
#   <domain>   A preference domain, such as com.apple.dock or NSGlobalDomain
#
# EXAMPLES
#   $ dot defaults diff com.apple.dock
#   $ dot defaults diff --current-host NSGlobalDomain
#
# EXIT CODES
#   0   changes found
#   1   nothing changed, or a domain couldn't be read
#   2   bad usage, or no terminal
set -eu
me="dot defaults diff"
say() { echo "$me: $*" >&2; }
usage() { say "$1"; echo "Run '$me --help' for usage." >&2; exit 2; }

host= scope="user preferences"
if [ "${1:-}" = --current-host ]; then host=-currentHost scope="this Mac's preferences"; shift; fi
[ $# -ge 1 ] || usage "name at least one domain, such as com.apple.dock"
# Arguments are never echoed back, since a domain name can be private too:
# they're referred to by position.
n=0
for d in "$@"; do
  n=$((n + 1))
  case $d in
    '') usage "domain $n is empty" ;;
    -*) usage "argument $n isn't a domain (--current-host goes first)" ;;
    */*) usage "domain $n is a path; name a domain instead" ;;
  esac
done
# The human makes the change, so there must be someone to ask.
{ : </dev/tty; } 2>/dev/null || usage "needs a terminal: you change the setting while it waits"

# Snapshots live in a private folder (0700, files 0600 from creation), removed
# on exit and on the signals a shell can catch. A forced kill (kill -9) skips
# that and leaves the folder in $TMPDIR.
umask 077
dir=$(mktemp -d "${TMPDIR:-/tmp}/dot-defaults-diff.XXXXXX") || exit 1
trap 'rm -rf "$dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
export LC_ALL=C   # sort and comm must agree on order
n=0
for d in "$@"; do n=$((n + 1)); printf '%s' "$d" > "$dir/domain.$n"; done

# The reader of `defaults export`'s XML: one record per value, as
# domain-number <tab> path <tab> type <tab> value. Split on "<", so each piece
# is one tag and its text (text escapes its own "<"); lines are joined with
# \001, since awk's split also breaks on newlines. Exits 1 on anything that
# isn't a complete plist, so a bad read never looks like removed keys.
cat > "$dir/flatten.awk" <<'EOF'
{ buf = buf $0 "\001" }
END {
  n = split(buf, parts, "<")
  for (i = 2; i <= n; i++) {
    p = parts[i]; gt = index(p, ">")
    if (gt == 0) exit 1
    tag = substr(p, 1, gt - 1); text = substr(p, gt + 1)
    if (tag ~ /^[?!]/ || tag ~ /^plist/) continue
    if (tag == "/plist") { closed = 1; continue }
    if (tag == "key") { pending = unesc(text); continue }
    if (tag ~ /^\//) { if (tag == "/dict" || tag == "/array") depth--; if (depth < 0) exit 1; continue }
    if (depth == 0) { if (root) exit 1; name = ""; root = 1 }
    else if (kind[depth] == "dict") name = pending
    else name = idx[depth]++
    path = (depth <= 1) ? name : prefix[depth] ":" name
    if (tag ~ /^(dict|array)\/?$/) {
      t = tag; sub(/\/$/, "", t)
      if (depth > 0) emit(path, t, "")
      if (tag !~ /\/$/) { depth++; kind[depth] = t; idx[depth] = 0; prefix[depth] = path }
      continue
    }
    if (tag == "true/" || tag == "false/") { emit(path, "bool", substr(tag, 1, length(tag) - 1)); continue }
    if (tag !~ /^(string|integer|real|date|data)\/?$/) exit 1
    t = tag; sub(/\/$/, "", t)
    if (tag ~ /\/$/) text = ""
    if (t == "data") gsub(/[ \t\001]/, "", text)
    emit(path, t, text)
  }
  if (!root || !closed || depth != 0) exit 1
}
function unesc(s) {
  gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&quot;/, "\"", s); gsub(/&apos;/, "\047", s); gsub(/&amp;/, "\\&", s)
  return s
}
function emit(path, type, value) {
  gsub(/\\/, "\\\\", value); gsub(/\t/, "\\t", value); gsub(/\001/, "\\n", value)
  gsub(/\\/, "\\\\", path); gsub(/\t/, "\\t", path); gsub(/\001/, "\\n", path)
  print dom "\t" path "\t" type "\t" value
}
EOF

# snapshot <name> <domain>...: the domains, as records in $dir/<name>.tsv.
# Fails if any domain can't be exported or read.
snapshot() {
  name=$1; shift
  : > "$dir/$name.tsv"
  i=0
  for d in "$@"; do
    i=$((i + 1))
    defaults $host export "$d" - > "$dir/$name.plist" 2>/dev/null &&
      awk -v dom="$i" -f "$dir/flatten.awk" "$dir/$name.plist" >> "$dir/$name.tsv" ||
      { say "couldn't read domain $i; nothing was compared"; return 1; }
  done
  rm -f "$dir/$name.plist"
}

# changed <a> <b>: the paths (domain-number <tab> path) whose type or value differ.
changed() {
  awk -F '\t' 'NR == FNR { a[$1 FS $2] = $3 FS $4; next }
    { k = $1 FS $2; if (!(k in a) || a[k] != $3 FS $4) print k; delete a[k] }
    END { for (k in a) print k }' "$1" "$2" | sort
}

say "reading $# domain(s) of your $scope…"
snapshot a "$@" || exit 1
sleep 3
snapshot b "$@" || exit 1
changed "$dir/a.tsv" "$dir/b.tsv" > "$dir/noise"
say "change one setting in System Settings, then press Enter here."
IFS= read -r _ </dev/tty || exit 2
say "reading them again…"
snapshot c "$@" || exit 1
changed "$dir/b.tsv" "$dir/c.tsv" | comm -23 - "$dir/noise" > "$dir/changed"

# One item per top-level key: added, removed, or changed (itself or inside
# it). A key whose only change is a date is left out: a timestamp, never a
# setting. Items: number, domain-number, key, status, type before, type
# after, changes inside (tab-separated).
awk -F '\t' -v OFS='\t' '
  FILENAME == ARGV[1] { ch[$1 FS $2] = 1; next }
  FILENAME == ARGV[2] { old[$1 FS $2] = $3; next }
  { new[$1 FS $2] = $3 }
  END {
    for (k in ch) {
      split(k, p, FS); top = p[2]; sub(/:.*/, "", top); tk = p[1] FS top
      o = (k in old) ? old[k] : ""; nw = (k in new) ? new[k] : ""
      if ((o == "" || o == "date") && (nw == "" || nw == "date")) continue
      keys[tk] = 1
      if (p[2] != top) inside[tk]++
    }
    for (tk in keys) {
      ot = (tk in old) ? old[tk] : ""; nt = (tk in new) ? new[tk] : ""
      st = (ot == "") ? "added" : (nt == "") ? "removed" : "changed"
      print tk, st, ot, nt, inside[tk] + 0
    }
  }' "$dir/changed" "$dir/b.tsv" "$dir/c.tsv" | sort -t "$(printf '\t')" -k1,1n -k2,2 |
  awk -v OFS='\t' '{ print NR, $0 }' > "$dir/items"

total=$(wc -l < "$dir/items" | tr -d ' ')
if [ "$total" -eq 0 ]; then
  say "no preference changed in the domain(s) you named. The setting may live in another domain, in an app's sandbox, or outside preferences (pmset, scutil, the privacy database, a profile)."
  exit 1
fi

# The report, on stdout: counts and change numbers only.
awk -F '\t' -v scope="$scope" -v nd="$#" '
  { c[$2 FS $4]++; line[$2] = line[$2] "  " $1 "  " $4 (($4 == "changed" && $7 > 0) ? " (inside it)" : "") "\n" }
  END {
    for (i = 1; i <= nd; i++) {
      if (!(i in line)) { printf "domain %d (%s): no changes\n", i, scope; continue }
      printf "domain %d (%s): %d added, %d changed, %d removed\n%s", i, scope, c[i FS "added"], c[i FS "changed"], c[i FS "removed"], line[i]
    }
  }' "$dir/items"

# What some setting in src/settings/ already writes, as domain <tab> key <tab>
# "topic setting". Only shown when a change is revealed.
awk -v want="$([ -n "$host" ] && echo host || echo user)" '
  /^[[:space:]]*#/ { next }
  /^[a-z0-9_]+\(\) *\{/ { fn = $1; sub(/\(\).*/, "", fn); next }
  fn != "" {
    for (i = 1; i <= NF && $i !~ /^default(_unset)?$/; i++) ;
    if (i > NF) next
    i++; h = "user"
    if ($i == "-currentHost") { h = "host"; i++ }
    d = $i; k = $(i + 1); gsub(/"/, "", d); gsub(/"/, "", k)
    if (h != want || d ~ /^\$/ || k ~ /^\$/ || d == "" || k == "") next
    s = fn; sub(/_/, " ", s); gsub(/_/, "-", s)
    print d "\t" k "\t" s
  }' "$DOT_ROOT"/src/settings/*.sh | sort -u > "$dir/managed"

# Revealing is deliberate, one change at a time, and goes to the terminal
# only, never to stdout.
{
  echo
  echo "To see a change's key name and type, type its number. A key name can be"
  echo "private: don't paste it anywhere without reading it first. Values are"
  echo "never shown. Press Enter alone to finish."
} >/dev/tty
while printf '> ' >/dev/tty && IFS= read -r pick </dev/tty && [ -n "$pick" ]; do
  case $pick in *[!0-9]*) echo "a number from 1 to $total" >/dev/tty; continue ;; esac
  item=$(awk -F '\t' -v n="$pick" '$1 == n' "$dir/items")
  [ -n "$item" ] || { echo "a number from 1 to $total" >/dev/tty; continue; }
  # cut, not read: read would merge an empty field (no type before) into the next.
  field() { printf '%s\n' "$item" | cut -f "$1"; }
  dn=$(field 2) key=$(field 3) st=$(field 4) ot=$(field 5) nt=$(field 6) ins=$(field 7)
  domain=$(cat "$dir/domain.$dn")
  # Control characters in a key (a terminal escape, say) are dropped, not printed.
  key=$(printf '%s' "$key" | tr -d '\000-\010\013-\037\177')
  types=$ot
  [ "$st" = added ] && types=$nt
  [ "$st" = changed ] && [ "$ot" != "$nt" ] && types="$ot → $nt"
  extra=; [ "$ins" -gt 0 ] && extra=", $ins value(s) inside it changed"
  setting=$(awk -F '\t' -v d="$domain" -v k="$key" '$1 == d && $2 == k { print $3; exit }' "$dir/managed")
  printf '%s: %s key %s (%s%s)%s\n' "$pick" "$st" "$key" "$types" "$extra" \
    "${setting:+; a setting already writes it: $setting}" >/dev/tty
done
exit 0
