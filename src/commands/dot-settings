#!/bin/sh
# Summary: List the settings you can use in config/
# Usage: dot settings [<topic>]
# Group: core
#
# Lists every setting dot knows, with its values and what it does, and what
# config/ sets it to. Settings are defined in src/settings/<topic>.sh; the
# comment above each function is its documentation.
#
# EXAMPLES
#   $ dot settings
#   $ dot settings trackpad
set -eu

# index: one line per setting, tab-separated: topic, setting, syntax, description.
index() {
  awk '
    FNR == 1 { block = "" }
    /^#/ { sub(/^# ?/, ""); block = block (block == "" ? "" : "\n") $0; next }
    /^[a-z]+_[a-z_]+\(\) \{/ {
      n = split(block, line, "\n")
      split(line[1], w, " ")
      syntax = line[1]; desc = ""
      if (match(line[1], /   +/)) { syntax = substr(line[1], 1, RSTART - 1); desc = substr(line[1], RSTART + RLENGTH) }
      for (i = 2; i <= n; i++) desc = desc (desc == "" ? "" : " ") line[i]
      printf "%s\t%s\t%s\t%s\n", w[1], w[2], syntax, desc
    }
    { block = "" }
  ' "$DOT_ROOT"/src/settings/*.sh
}

case ${1:-} in
  --index) index; exit 0 ;;   # machine-readable; used by completion
  -*) echo "dot settings: unknown flag '$1'" >&2; exit 2 ;;
esac
[ $# -le 1 ] || { echo "dot settings: expected at most one topic" >&2; exit 2; }

if [ $# -eq 1 ] && [ ! -f "$DOT_ROOT/src/settings/$1.sh" ]; then
  echo "dot settings: no topic '$1'. Topics: $(cd "$DOT_ROOT/src/settings" && ls *.sh | sed 's/\.sh$//' | tr '\n' ' ')" >&2
  exit 2
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then bold=$(printf '\033[1m') dim=$(printf '\033[2m') off=$(printf '\033[0m'); else bold= dim= off=; fi

index | while IFS="$(printf '\t')" read -r topic setting syntax desc; do
  [ $# -eq 0 ] || [ "$topic" = "$1" ] || continue
  printf '%s%s%s\n' "$bold" "$syntax" "$off"
  [ -z "$desc" ] || printf '%s\n' "$desc" | fold -s -w 74 | sed 's/^/    /'
  grep -H "^$topic $setting " "$DOT_ROOT"/config/*.conf 2>/dev/null |
    sed "s#^$DOT_ROOT/##; s#^\([^:]*\):#    ${dim}in \1:${off} #" || true
  echo
done
