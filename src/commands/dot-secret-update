#!/bin/sh
# Summary: Replace the value of an existing secret
# Usage: dot secret update <name>
# Group: secret
#
# Asks for the new value without showing it (or reads it from stdin when
# piped) and replaces the secret's value, keeping its reference, so every
# .env.schema that uses it gets the new value on its next run.
#
# EXAMPLES
#   $ dot secret update myapp-payments
set -eu
. "$DOT_ROOT/src/lib/secret.sh"
secret_args update "$@"
if ! op_secret_exists "$vault" "$name"; then
  echo "dot secret update: no secret $name in $vault. To create it: dot secret add $name" >&2
  exit 1
fi
secret_read_value update
printf '%s' "$value" | op_secret_update "$vault" "$name"
echo "dot secret update: updated $name in $vault" >&2
