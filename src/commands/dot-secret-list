#!/bin/sh
# Summary: List secrets with their references, never their values
# Usage: dot secret list
# Group: secret
#
# One line per secret in the vault set under [secrets] in dot.toml: name, last
# update, and the reference a .env.schema uses.
set -eu
. "$DOT_ROOT/src/lib/secret.sh"
[ $# -eq 0 ] || { echo "dot secret list: takes no arguments" >&2; exit 2; }
secret_vault list
op_secret_list "$vault" | while IFS="$(printf '\t')" read -r name updated; do
  printf '%-32s %s  %s\n' "$name" "$updated" "$(op_secret_ref "$vault" "$name")"
done
