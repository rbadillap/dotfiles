#!/bin/sh
# Summary: Print the zsh completion script
# Usage: dot completion zsh
# Group: additional
#
# dot init zsh already includes it, so with this repo's shell setup there's
# nothing to do. Otherwise, add this to ~/.zshrc:
#
#   eval "$(/path/to/dotfiles/bin/dot completion zsh)"
#
# Completion covers commands, config files, topics, settings and their values.
set -eu
[ "${1:-}" = zsh ] && [ $# -eq 1 ] || { echo "dot completion: expected 'zsh'" >&2; echo "Run 'dot completion --help' for usage." >&2; exit 2; }

cat <<EOF
_dot() {
  local -a candidates
  candidates=("\${(@f)\$("$DOT_ROOT/bin/dot" __complete "\${(@)words[2,CURRENT-1]}" 2>/dev/null)}")
  _describe 'dot' candidates
}
compdef _dot dot
EOF
