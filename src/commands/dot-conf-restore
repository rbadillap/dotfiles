#!/bin/sh
# Summary: Replace dot.toml with its backup from 1Password
# Usage: dot conf restore [--force]
# Group: conf
#
# Downloads "dotfiles: dot.toml" from 1Password (Touch ID). If you already
# have a dot.toml that differs from the backup, it stops unless you pass
# --force; the file it replaces is kept as dot.toml.before-restore.<date>,
# a new one each time.
#
# FLAGS
#   --force   Replace a dot.toml that differs from the backup
set -eu
force=0
case ${1:-} in
  '') ;;
  --force) [ $# -eq 1 ] || { echo "dot conf restore: too many arguments" >&2; exit 2; }; force=1 ;;
  *) echo "dot conf restore: unknown argument '$1'" >&2; echo "Run 'dot conf restore --help' for usage." >&2; exit 2 ;;
esac
. "$DOT_ROOT/src/lib/op.sh"
. "$DOT_ROOT/src/lib/conf.sh"
conf=$DOT_ROOT/dot.toml
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
op document get "dotfiles: dot.toml" --out-file "$tmp" --force >/dev/null 2>&1 ||
  { echo "dot conf restore: couldn't read \"dotfiles: dot.toml\" from 1Password (signed in, CLI integration on, backup exists?)" >&2; exit 1; }
conf_parse "$tmp" >/dev/null || { echo "dot conf restore: the backup isn't valid; nothing changed" >&2; exit 1; }
if [ -f "$conf" ] && cmp -s "$tmp" "$conf"; then
  echo "dot conf restore: dot.toml already matches the backup" >&2
elif [ -f "$conf" ] && [ "$force" != 1 ]; then
  echo "dot conf restore: your dot.toml differs from the backup. Run with --force to replace it (it's kept as dot.toml.before-restore.<date>)." >&2
  exit 1
else
  if [ -f "$conf" ]; then
    # noclobber: an existing backup is never overwritten, even by --force.
    backup=$conf.before-restore.$(date +%Y%m%d-%H%M%S)
    (set -C; cat "$conf" > "$backup") 2>/dev/null ||
      { echo "dot conf restore: couldn't keep your dot.toml as $(basename "$backup"); nothing changed" >&2; exit 1; }
    echo "dot conf restore: your previous dot.toml is kept as $(basename "$backup")" >&2
  fi
  cp "$tmp" "$conf"
  echo "dot conf restore: restored dot.toml from 1Password" >&2
fi
mkdir -p "$DOT_STATE"
shasum -a 256 "$conf" | cut -d' ' -f1 > "$(op_record "dotfiles: dot.toml")"
