#!/bin/sh
# A CLI whose token lives in 1Password, for every process, not only an
# interactive zsh. `op shim <cli>` links it as ~/.local/share/dotfiles/shims/<cli>,
# which config/shell/op.zsh puts first on PATH. It runs the real CLI through
# `op plugin run`, so the token goes into that process only.
#
# It never reads or prints a token's value: it only tests whether one is set.
# A token already in the environment is used only when 1Password set it: this
# shim (DOT_OP_SHIM, which the CLI's own children inherit, or set by hand next
# to `op run`) or an `op` that started it directly. Any other token, such as
# one a cloned repo's .env loads, is ignored with a message on stderr, and
# 1Password's is used instead. Without the 1Password plugin it does nothing.
#
# Which token: a person at a terminal (stdin or stderr is one, and no agent's
# variable is set) gets the plugin's, the personal one, after 1Password's
# approval. Anything else (an agent, a script without a terminal, launchd)
# gets the agent token when `op agent-token` set one up: `op run` reads it
# with a 1Password service account that can only read that vault, whose
# credential lives in the macOS keychain (service dotfiles-op-agents), so it
# asks no one. If any of that fails, the command fails: it never falls back
# to the personal token or to an approval prompt.
#
# gh's agent tokens are one per GitHub owner (a fine-grained token has a
# single owner), plus an optional one for everything else. The owner comes
# from the command (-R/--repo, GH_REPO, the repo it names) or the current
# folder's remote; see gh_owner. Picking a token is routing, not a boundary:
# every one of them is a token agents may use.
set -euf
# Only this shim decides which 1Password account op uses.
unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
name=${0##*/}
case $name in
  gh)     agentvar=GH_TOKEN vars="GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN" logins="auth login|auth logout|auth refresh" ;;
  vercel) agentvar=VERCEL_TOKEN vars="VERCEL_TOKEN" logins="login|logout" ;;
  *) echo "dot shim: no shim for '$name'" >&2; exit 2 ;;
esac

# PATH without this shim (compared by file, so any link to it counts), so the
# lookup below and op both find the real CLI and never this script again.
self=$(stat -L -f %d:%i "$0")
path=
IFS=:
for dir in ${PATH:-}; do
  [ -n "$dir" ] || continue
  [ -e "$dir/$name" ] && [ "$(stat -L -f %d:%i "$dir/$name")" = "$self" ] && continue
  path=${path:+$path:}$dir
done
unset IFS
PATH=$path
export PATH
real=$(command -v "$name") || { echo "dot shim: $name isn't installed" >&2; exit 127; }

# No 1Password plugin for this CLI: the shim has nothing to add.
if [ ! -f "$HOME/.config/op/plugins/$name.json" ] || ! command -v op >/dev/null; then
  exec "$real" "$@"
fi

token=
for var in $vars; do
  eval "[ -z \"\${$var:-}\" ]" || token="${token:+$token, }$var"
done
parent=$(ps -o comm= -p "$PPID")
if [ -n "$token" ]; then
  if [ "${DOT_OP_SHIM:-}" = "$name" ] || [ "${parent##*/}" = op ]; then
    exec "$real" "$@"
  fi
  echo "dot shim: ignoring $token: 1Password didn't set it, so $name uses one from 1Password." >&2
  for var in $vars; do unset "$var"; done
elif [ "${DOT_OP_SHIM:-}" = "$name" ]; then
  # op already ran for this process tree and set no token: never call it again.
  exec "$real" "$@"
fi

# Its login lives in 1Password, so the CLI's own login can't work here.
args="$* "
IFS='|'
for login in $logins; do
  case $args in "$login "*)
    echo "dot shim: $name's login lives in 1Password (op plugin init $name); '$name $login' doesn't apply." >&2
    echo "dot shim: check it with 'dot auth status'." >&2
    exit 1 ;;
  esac
done
unset IFS

# The GitHub owner (lowercase) in a repo name or URL: OWNER/REPO,
# github.com/OWNER/REPO, https://github.com/OWNER/REPO/..., or a remote's URL
# (git@HOST:OWNER/REPO.git, ssh://git@HOST/OWNER/REPO, where HOST may be an
# alias in ~/.ssh/config). Nothing for another host or anything else.
repo_owner() {
  r=$1 host=github.com
  case $r in
    *://*) r=${r#*://}; r=${r#*@}; host=${r%%/*}; r=${r#*/} ;;
    *:*) r=${r#*@}; host=${r%%:*}; r=${r#*:}
         case $host in */*) return 0 ;; esac ;;
    github.com/*) r=${r#github.com/} ;;
    */*/*) return 0 ;;
    */*) ;;
    *) return 0 ;;
  esac
  host=${host%%:*}
  case $host in
    github.com|www.github.com) ;;
    *[!A-Za-z0-9._-]*|'') return 0 ;;
    *) [ "$(ssh -G "$host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')" = github.com ] || return 0 ;;
  esac
  case $r in */?*) ;; *) return 0 ;; esac
  o=${r%%/*}
  case $o in ''|*[!A-Za-z0-9-]*) return 0 ;; esac
  printf %s "$o" | tr '[:upper:]' '[:lower:]'
}

# The agent token reference for a GitHub owner, from the agent tokens file.
owner_ref() {
  awk -v o="$1" '$1 == o && $2 ~ /^op:\/\// { sub(/^[^ ]+ /, ""); print; exit }' "$tokens"
}

# The owner of the repo in the current folder, chosen as gh chooses it: the
# remote `gh repo set-default` marked, then upstream, github, origin, then the
# owner every github.com remote shares. Remotes with different owners and none
# of those: it fails when any of them has an agent token, so it never guesses
# between two tokens; otherwise nothing.
cwd_owner() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  remotes=$(git remote 2>/dev/null) || return 0
  [ -n "$remotes" ] || return 0
  for r in $remotes; do
    v=$(git config --get "remote.$r.gh-resolved" 2>/dev/null) || continue
    case $v in */*) repo_owner "$v" ;; *) repo_owner "$(git remote get-url "$r")" ;; esac
    return 0
  done
  for want in upstream github origin; do
    for r in $remotes; do
      [ "$r" = "$want" ] && { repo_owner "$(git remote get-url "$r")"; return 0; }
    done
  done
  owners=
  for r in $remotes; do
    o=$(repo_owner "$(git remote get-url "$r")")
    [ -z "$o" ] || case " $owners " in *" $o "*) ;; *) owners="${owners:+$owners }$o" ;; esac
  done
  case $owners in
    *' '*)
      for o in $owners; do
        [ -z "$(owner_ref "$o")" ] && continue
        echo "dot shim: this repo's remotes belong to $owners, and gh can't tell which one you mean." >&2
        echo "dot shim: pass -R owner/repo, or run gh repo set-default." >&2
        return 1
      done ;;
    *) printf %s "$owners" ;;
  esac
}

# The owner a gh command targets, lowercase, or nothing: -R/--repo, then
# GH_REPO, then the repo the command names right after its subcommand (gh
# repo <command> OWNER/REPO or URL, gh pr|issue <command> URL) or the path of
# gh api (repos|orgs|users/OWNER/...), then the current folder's repo. Only
# those positions count, so a URL in a flag's value (--body) never does.
gh_owner() {
  prev=
  for a in "$@"; do
    [ "$a" != -- ] || break
    case $prev in -R|--repo) repo_owner "$a"; return 0 ;; esac
    case $a in
      --repo=*) repo_owner "${a#--repo=}"; return 0 ;;
      -R?*) repo_owner "${a#-R}"; return 0 ;;
    esac
    prev=$a
  done
  [ -z "${GH_REPO:-}" ] || { repo_owner "$GH_REPO"; return 0; }
  cmd=${1:-}
  [ $# -eq 0 ] || shift
  case $cmd in
    repo|pr|issue)
      a=${2:-}
      case $a in
        https://*|http://*) repo_owner "$a"; return 0 ;;
        -*|'') ;;
        *) [ "$cmd" != repo ] || { repo_owner "$a"; return 0; } ;;
      esac ;;
    api)
      for a in "$@"; do
        case $a in
          repos/*|/repos/*|orgs/*|/orgs/*|users/*|/users/*)
            o=${a#/}; o=${o#*/}; o=${o%%/*}; o=${o%%\?*}
            case $o in ''|*[!A-Za-z0-9-]*) ;; *) printf %s "$o" | tr '[:upper:]' '[:lower:]'; return 0 ;; esac
            break ;;
        esac
      done ;;
  esac
  cwd_owner
}

DOT_OP_SHIM=$name
export DOT_OP_SHIM

# Agent tokens, once set up (`op agent-token`): a 1Password reference per
# CLI, not a value. From then on an agent never gets the personal token: a
# CLI without an agent token of its own fails for agents.
tokens=$HOME/.local/share/dotfiles/agent-tokens/$name
if [ -d "${tokens%/*}" ]; then
  person=
  if { [ -t 0 ] || [ -t 2 ]; } && [ -z "${AI_AGENT:-}${CLAUDECODE:-}${CODEX_SANDBOX:-}${CURSOR_AGENT:-}${GEMINI_CLI:-}" ]; then
    person=1
  fi
  if [ -z "$person" ]; then
    [ -e "$tokens" ] || {
      echo "dot shim: no agent token for $name; agents never get your personal one. Run it from your terminal." >&2
      exit 1
    }
    ref=
    if [ "$name" = gh ] && grep -q '^[A-Za-z0-9-]* op://' "$tokens" 2>/dev/null; then
      # One token per GitHub owner: the owner this command targets picks it.
      owner=$(gh_owner "$@") || exit 1
      [ -z "$owner" ] || ref=$(owner_ref "$owner")
    fi
    [ -n "$ref" ] || ref=$(grep -m 1 '^op://' "$tokens" 2>/dev/null) || {
      if [ -n "${owner:-}" ]; then
        echo "dot shim: no agent token for $owner and no agent_token to fall back on; not falling back to your personal token." >&2
        echo "dot shim: add $owner under [github.agent_tokens] in dot.toml, or pass -R owner/repo." >&2
      else
        echo "dot shim: no agent token reference in $tokens; not falling back to your personal token." >&2
      fi
      exit 1
    }
    # The service account's credential goes only into op run's environment;
    # env -u keeps it from $name and its children.
    sa=$(/usr/bin/security find-generic-password -s dotfiles-op-agents -a "${USER:-$(id -un)}" -w 2>/dev/null) && [ -n "$sa" ] || {
      echo "dot shim: no 1Password service account credential in the keychain (dotfiles-op-agents); not falling back to your personal token." >&2
      exit 1
    }
    eval "$agentvar=\$ref"
    export "$agentvar"
    OP_SERVICE_ACCOUNT_TOKEN=$sa
    unset sa
    export OP_SERVICE_ACCOUNT_TOKEN
    # op run also masks the agent token if the command prints it (gh auth token).
    exec op run -- env -u OP_SERVICE_ACCOUNT_TOKEN "$name" "$@"
  fi
fi

exec op plugin run -- "$name" "$@"
